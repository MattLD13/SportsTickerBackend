# Activate an immutable core release with shared runtime state.
[Unit]
Description=Sports Ticker Backend Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/backend-components/core/current
Environment=TICKER_ENV_FILE=/home/ubuntu/.env
Environment=TICKER_WORKER_DIRECTORY=/home/ubuntu/ticker_data/backend_sockets
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TICKER_STOCK_CACHE_PATH=/home/ubuntu/ticker_data/stocks.json
ExecStart=/home/ubuntu/backend-components/core/current/.venv/bin/python -m sports_ticker.server
Restart=always
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=8192
TasksMax=256
MemoryAccounting=true
MemoryHigh=4G
MemoryMax=8G
StandardOutput=append:/home/ubuntu/ticker-backend.log
StandardError=append:/home/ubuntu/ticker-backend.log

[Install]
WantedBy=multi-user.target
