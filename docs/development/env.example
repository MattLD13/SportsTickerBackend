# Copy this file to .env for local backend development.
# The server loads .env through python-dotenv.
TICKER_BIND_HOST=127.0.0.1
TICKER_PORT=5000
TICKER_HTTP_THREADS=8
TICKER_DATABASE_PATH=ticker_data/ticker-v2.sqlite3
TICKER_REFRESH_TICK_SECONDS=0.2

# Add Spotify credentials when you configure the integration.
# Register the callback URI with your Spotify application.
# Use a Fernet key for SPOTIFY_TOKEN_ENCRYPTION_KEY.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CALLBACK_URI=
# SPOTIFY_APP_RETURN_URI=tickercontrol://spotify
# SPOTIFY_TOKEN_ENCRYPTION_KEY=
