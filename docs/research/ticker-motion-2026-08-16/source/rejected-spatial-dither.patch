+def _cover_fractional_column(
+    image: Image.Image,
+    width: int,
+    height: int,
+    phase: float,
+    position: int,
+) -> Image.Image:
+    """Dither exact source columns to simulate slow spatial coverage without RGB mixing."""
+
+    current = image.crop((0, 0, width, height))
+    following = image.crop((1, 0, width + 1, height))
+    quantum = max(0, min(64, round(max(0.0, min(1.0, phase)) * 64)))
+    if quantum <= 0:
+        return current
+    if quantum >= 64:
+        return following
+    base = _coverage_mask_base(width, height, quantum)
+    shifted = ImageChops.offset(base, -(position % _RANK_TILE_SIZE), 0)
+    return Image.composite(following, current, shifted.crop((0, 0, width, height)))
+
