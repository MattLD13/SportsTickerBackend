[
  {
    "id": "racing.session",
    "version": 1,
    "panels": {
      "w384h32": {"box": [384, 32], "flow": "page", "dwell": 10, "parts": [
        {"part": "icon", "at": [4, 2], "value": "flag"},
        {"part": "text", "at": [22, 2], "font": "small", "color": "#ff2020", "value": "F1 {round}"},
        {"part": "text", "at": [70, 2], "font": "small", "value": "{event}"},
        {"part": "text", "at": [22, 12], "font": "tiny", "color": "#a0a0a0", "value": "{circuit}"},
        {"part": "text", "at": [22, 22], "font": "tiny", "color": "#a0a0a0", "value": "{place}"},
        {"part": "text", "at": [250, 2], "font": "small", "align": "center", "color": "#ffd000", "value": "{session}"},
        {"part": "time", "at": [250, 15], "font": "tiny", "align": "center", "value": "{starts}", "tz": "{ticker.tz}", "format": "weekday_time", "show_when": "state == pre"},
        {"part": "text", "at": [250, 15], "font": "tiny", "align": "center", "color": "#40ff40", "value": "LIVE NOW", "show_when": "state == in"},
        {"part": "icon", "at": [322, 3], "value": "{weather.icon}", "show_when": "weather.icon"},
        {"part": "text", "at": [342, 3], "font": "small", "value": "{weather.temp}", "show_when": "weather.temp"},
        {"part": "text", "at": [322, 20], "font": "tiny", "color": "#a0a0a0", "value": "{weather.wind}", "show_when": "weather.wind"}
      ]},
      "w64h32": {"box": [64, 32], "flow": "page", "dwell": 8, "parts": [
        {"part": "text", "at": [1, 0], "font": "tiny", "color": "#ff2020", "value": "F1"},
        {"part": "text", "at": [63, 0], "font": "tiny", "align": "right", "color": "#ffd000", "value": "{session_short}"},
        {"part": "text", "at": [1, 10], "font": "tiny", "max_width": 62, "value": "{city}"},
        {"part": "time", "at": [1, 21], "font": "tiny", "color": "#c0c0c0", "value": "{starts}", "tz": "{ticker.tz}", "format": "weekday_time", "show_when": "state == pre"},
        {"part": "text", "at": [1, 21], "font": "tiny", "color": "#40ff40", "value": "LIVE", "show_when": "state == in"},
        {"part": "text", "at": [63, 21], "font": "tiny", "align": "right", "value": "{weather.temp}", "show_when": "weather.temp"}
      ]}
    }
  }
]
