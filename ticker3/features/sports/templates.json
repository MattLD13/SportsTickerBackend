[
  {
    "id": "sports.card",
    "version": 1,
    "panels": {
      "w384h32": {"box": [96, 32], "flow": "scroll", "parts": [
        {"part": "text", "at": [48, 0], "font": "tiny", "align": "center", "color": "#ffd000", "value": "{status}", "show_when": "state == in"},
        {"part": "text", "at": [48, 0], "font": "tiny", "align": "center", "color": "#c0c0c0", "value": "{status}", "show_when": "state == post"},
        {"part": "time", "at": [48, 0], "font": "tiny", "align": "center", "color": "#c0c0c0", "value": "{starts}", "tz": "{ticker.tz}", "format": "weekday_time", "show_when": "state == pre"},
        {"part": "rect", "at": [3, 9], "size": [90, 1], "color": "#303030"},
        {"part": "logo", "at": [2, 11], "size": 20, "value": "{away.logo}"},
        {"part": "logo", "at": [74, 11], "size": 20, "value": "{home.logo}"},
        {"part": "text", "at": [48, 11], "font": "medium", "align": "center", "value": "{away.score}-{home.score}", "show_when": "state != pre"},
        {"part": "text", "at": [48, 14], "font": "small", "align": "center", "color": "#909090", "value": "{away.abbr} {home.abbr}", "show_when": "state == pre"},
        {"part": "text", "at": [48, 23], "font": "tiny", "align": "center", "color": "#40ff40", "value": "{down}", "show_when": "down"},
        {"part": "icon", "at": [24, 26], "value": "football", "show_when": "possession == away"},
        {"part": "icon", "at": [65, 26], "value": "football", "show_when": "possession == home"},
        {"part": "bases", "at": [42, 24], "size": 3, "value": "{bases}", "show_when": "sport == baseball"}
      ]},
      "w64h32": {"box": [64, 32], "flow": "page", "dwell": 6, "parts": [
        {"part": "text", "at": [32, 0], "font": "tiny", "align": "center", "color": "#ffd000", "value": "{status}", "show_when": "state == in"},
        {"part": "text", "at": [32, 0], "font": "tiny", "align": "center", "color": "#c0c0c0", "value": "{status}", "show_when": "state == post"},
        {"part": "time", "at": [32, 0], "font": "tiny", "align": "center", "color": "#c0c0c0", "value": "{starts}", "tz": "{ticker.tz}", "format": "weekday_time", "show_when": "state == pre"},
        {"part": "logo", "at": [1, 10], "size": 10, "value": "{away.logo}"},
        {"part": "text", "at": [13, 10], "font": "tiny", "color": "{away.color}", "value": "{away.abbr}"},
        {"part": "text", "at": [63, 10], "font": "small", "align": "right", "value": "{away.score}"},
        {"part": "logo", "at": [1, 21], "size": 10, "value": "{home.logo}"},
        {"part": "text", "at": [13, 21], "font": "tiny", "color": "{home.color}", "value": "{home.abbr}"},
        {"part": "text", "at": [63, 21], "font": "small", "align": "right", "value": "{home.score}"},
        {"part": "icon", "at": [36, 13], "value": "football", "show_when": "possession == away"},
        {"part": "icon", "at": [36, 24], "value": "football", "show_when": "possession == home"},
        {"part": "bases", "at": [33, 13], "size": 3, "value": "{bases}", "show_when": "sport == baseball"}
      ]}
    }
  }
]
