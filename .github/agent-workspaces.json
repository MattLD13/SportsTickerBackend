    "six-build": {
      "owner": "Existing Six package import dependencies",
      "dependencies": [
        "server-core"
      ],
      "owned": [],
      "context": [],
      "build": [
        "ticker_core/*",
        "sports_ticker/assets/*.py"
      ],
      "checks": []
