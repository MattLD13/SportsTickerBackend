{
  "version": 1,
  "shared_owners": [
    "server-core",
    "sports-server",
    "shared-drawing"
  ],
  "shared_consumers": [
    "mini-firmware",
    "six-runtime",
    "app-contracts"
  ],
  "components": {
    "instructions": {
      "owner": "Repository task and validation instructions",
      "owned": [],
      "dependencies": [],
      "context": [
        "AGENTS.md",
        "tests/AGENTS.md",
        "docs/contracts/overview.md"
      ],
      "build": [
        ".gitignore",
        ".gitattributes",
        "pyproject.toml",
        "requirements.txt",
        "requirements-backend.txt"
      ],
      "checks": []
    },
    "python-build": {
      "owner": "Python package initialization and import dependencies",
      "owned": [],
      "dependencies": [
        "instructions"
      ],
      "context": [],
      "build": [
        "sports_ticker/__init__.py",
        "sports_ticker/leagues.py",
        "sports_ticker/markets.py",
        "sports_ticker/providers/*.py",
        "ticker_core/protocol/*.py",
        "ticker_core/rendering/*",
        "ticker_core/rendering/font_assets/*",
        "ticker_core/__init__.py",
        "ticker_core/_enum.py",
        "ticker_core/context.py",
        "ticker_core/registry.py",
        "ticker_core/scene.py"
      ],
      "checks": []
    },
    "server-core": {
      "owner": "V2 models, projection, API, persistence, and runtime",
      "owned": [
        "sports_ticker/domain/*",
        "sports_ticker/projections/*",
        "sports_ticker/api/*",
        "sports_ticker/application/*",
        "sports_ticker/fleet/*",
        "docs/contracts/*",
        "ticker_core/protocol/*"
      ],
      "dependencies": [
        "python-build"
      ],
      "context": [
        "sports_ticker/domain/models.py",
        "sports_ticker/projections/data_api.py",
        "sports_ticker/projections/device_data.py",
        "sports_ticker/projections/mini_fields.py"
      ],
      "build": [
        "sports_ticker/domain/*.py",
        "sports_ticker/projections/*",
        "tools/mini/generate_mini_fields.py",
        "esp32_hub75/src/mini/protocol/fields_generated.h",
        "sports_ticker/application/*.py",
        "sports_ticker/fleet/*.py"
      ],
      "checks": [
        "mini-fields"
      ]
    },
    "sports-server": {
      "owner": "Shared sports provider facts and score alerts for both devices",
      "owned": [
        "sports_ticker/providers/espn*.py",
        "sports_ticker/providers/nhl_live.py",
        "sports_ticker/providers/sports_display.py",
        "sports_ticker/providers/score_alerts.py",
        "sports_ticker/providers/fotmob.py"
      ],
      "dependencies": [
        "server-core"
      ],
      "context": [
        "sports_ticker/providers/espn.py",
        "sports_ticker/providers/sports_display.py",
        "sports_ticker/providers/nhl_live.py",
        "sports_ticker/providers/score_alerts.py"
      ],
      "build": [
        "tests/python/protocol/test_hockey_shootout_alert.py",
        "tests/python/protocol/test_mini_hockey_contract.py",
        "tests/python/protocol/test_mini_fields.py",
        "tests/python/protocol/test_sports_display.py",
        "tests/python/protocol/test_sports_lifecycle.py",
        "tests/python/protocol/test_nhl_live.py",
        "tests/fixtures/display/*.json",
        "tools/mini/generate_mini_fields.py",
        "tools/mini/generate_mini_ui.py",
        "esp32_hub75/src/mini/protocol/fields_generated.h",
        "esp32_hub75/src/mini/rendering/ui_generated.h"
      ],
      "checks": [
        "sports-contracts",
        "mini-ui"
      ]
    },
    "mini-firmware": {
      "owner": "Mini protocol, runtime, and 64x32 renderers",
      "owned": [
        "esp32_hub75/*"
      ],
      "dependencies": [
        "sports-server"
      ],
      "context": [
        "esp32_hub75/src/mini/protocol/payload.inc",
        "esp32_hub75/src/mini/rendering/presentation.inc",
        "esp32_hub75/src/mini/rendering/sports_pane.h",
        "esp32_hub75/src/mini/rendering/glyphs.h",
        "tests/python/protocol/test_hockey_shootout_alert.py",
        "tests/python/protocol/test_mini_hockey_contract.py",
        "tests/native/mini_hockey_panes.cpp"
      ],
      "build": [
        "esp32_hub75/src/mini/protocol/*",
        "esp32_hub75/src/mini/rendering/*",
        "esp32_hub75/src/mini/assets/mini_artwork.h",
        "esp32_hub75/src/mini/assets/mini_sprite.h",
        "esp32_hub75/platformio.ini",
        "esp32_hub75/partitions.csv",
        "tests/native/mini_hockey_panes.cpp"
      ],
      "checks": [
        "mini-native"
      ]
    },
    "six-runtime": {
      "owner": "Ticker Six runtime and 384x32 renderers",
      "owned": [
        "ticker_core/*",
        "updater.py",
        "setup.sh",
        "ticker-controller.service"
