      "dependencies": [
        "sports-server"
      ],
      "context": [
        "ticker_core/features/sports/renderer.py",
        "ticker_core/features/sports/pinned.py"
      ],
      "build": [
        "ticker_core/*",
        "tools/rendering/render_frame.py",
        "tests/python/features/sports/test_sports_renderers.py",
        "sports_ticker/assets/__init__.py",
        "sports_ticker/assets/images.py"
      ],
      "checks": [
        "six-sports"
      ]
    },
    "app-contracts": {
      "owner": "iOS V2 contract consumers",
      "owned": [
        "TickerControlApp/*"
      ],
      "dependencies": [
        "server-core"
      ],
      "context": [
        "TickerControlApp/TickerControl/Models/TickerContentModels.swift",
        "TickerControlApp/TickerControlTests/ContractModelsTests.swift"
      ],
      "build": [
        "TickerControlApp/*"
      ],
      "checks": []
    },
    "music": {
      "owner": "Music provider and device presentation",
      "owned": [
        "sports_ticker/providers/music.py",
        "ticker_core/features/music/*"
      ],
      "dependencies": [
        "server-core",
        "six-build"
      ],
      "context": [
        "sports_ticker/providers/music.py"
      ],
      "build": [
