  "slices": {
    "mini-sports": [
      "mini-firmware"
    ],
    "six-sports": [
      "six-runtime"
    ],
    "shared-sports": [
      "sports-server",
      "mini-firmware",
      "six-runtime",
      "app-contracts"
    ],
    "music": [
      "music"
    ],
    "weather": [
      "weather"
    ],
    "stocks": [
      "stocks"
    ],
    "flights": [
      "flights"
    ],
    "airports": [
      "airports"
    ],
    "golf": [
      "golf"
    ],
    "racing": [
      "racing"
    ],
    "news": [
      "news"
    ]
  },
  "checks": {
    "sports-contracts": {
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/python/protocol/test_hockey_shootout_alert.py",
        "tests/python/protocol/test_mini_hockey_contract.py",
        "tests/python/protocol/test_mini_fields.py",
        "tests/python/protocol/test_sports_display.py",
        "tests/python/protocol/test_sports_lifecycle.py",
        "tests/python/protocol/test_nhl_live.py"
      ],
      "files": [
        "tests/python/protocol/test_hockey_shootout_alert.py",
        "tests/python/protocol/test_mini_hockey_contract.py",
        "tests/python/protocol/test_mini_fields.py",
        "tests/python/protocol/test_sports_display.py",
        "tests/python/protocol/test_sports_lifecycle.py",
        "tests/python/protocol/test_nhl_live.py"
      ]
    },
    "mini-fields": {
      "argv": [
        "{python}",
        "tools/mini/generate_mini_fields.py",
        "--check"
      ],
      "files": [
        "tools/mini/generate_mini_fields.py"
      ]
    },
    "mini-ui": {
      "argv": [
        "{python}",
        "tools/mini/generate_mini_ui.py",
        "--check"
      ],
      "files": [
        "tools/mini/generate_mini_ui.py",
        "esp32_hub75/src/mini/rendering/ui_generated.h"
      ]
    },
    "mini-native": {
      "argv": [
        "{python}",
        "{tools}/workspaces/native_hockey.py"
      ],
      "files": [
        "tests/native/mini_hockey_panes.cpp",
        "tests/fixtures/display/mini_hockey_panes.json"
      ]
    },
    "six-sports": {
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/python/features/sports/test_sports_renderers.py"
      ],
      "files": [
