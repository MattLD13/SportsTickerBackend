    "shared-drawing": {
      "owner": "Shared glyphs and style exported to Mini firmware",
      "dependencies": [
        "sports-server"
      ],
      "owned": [
        "ticker_core/rendering/pixels.py",
        "ticker_core/rendering/style.py"
      ],
      "context": [
        "ticker_core/rendering/pixels.py",
        "ticker_core/rendering/style.py"
      ],
      "build": [],
      "checks": [
        "mini-ui"
      ]
    }
