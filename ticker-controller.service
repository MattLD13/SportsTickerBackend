[Unit]
Description=Sports Ticker Controller (LED Display)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/home/mld
Environment=TICKER_DATA_DIR=/home/mld/ticker
Environment=TICKER_VERIFY_TLS=true
ExecStart=/usr/bin/env python3 -m ticker_core
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/ticker.log
StandardError=append:/home/pi/ticker.log

[Install]
WantedBy=multi-user.target
