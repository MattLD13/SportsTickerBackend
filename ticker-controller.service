[Unit]
Description=Sports Ticker Controller (LED Display)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sports-ticker/current
Environment=TICKER_DATA_DIR=/home/mld/ticker
Environment=TICKER_RELEASE_ROOT=/opt/sports-ticker
Environment=TICKER_RELEASE_LINK=/opt/sports-ticker/current
Environment=TICKER_VERIFY_TLS=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TICKER_POLL_PROCESS=1
Environment=TICKER_RENDER_CPU=3
Environment=TICKER_POLL_CPU=2
ExecStart=/usr/bin/env python3 -m ticker_core
Restart=always
RestartSec=5
StandardOutput=append:/home/mld/ticker.log
StandardError=append:/home/mld/ticker.log

[Install]
WantedBy=multi-user.target
