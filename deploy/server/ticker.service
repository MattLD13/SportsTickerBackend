# Run the Ticker 3 core from the current release. The core supervisor starts the provider workers.
[Unit]
Description=Sports Ticker Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ticker3/current
Environment=TICKER_ENV_FILE=/home/ubuntu/.env
Environment=TICKER_DATABASE_PATH=/home/ubuntu/ticker_data/ticker-v2.sqlite3
Environment=TICKER3_RELEASES=/home/ubuntu/ticker3/releases
Environment=TICKER3_SOCKET=/home/ubuntu/ticker_data/ticker3.sock
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TICKER_STOCK_CACHE_PATH=/home/ubuntu/ticker_data/stocks.json
ExecStart=/home/ubuntu/ticker3/current/.venv/bin/python -m ticker.server
# Stop only the core. The workers keep running, and the next core adopts them.
KillMode=process
Restart=always
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=8192
TasksMax=512
MemoryAccounting=true
MemoryHigh=6G
MemoryMax=10G
StandardOutput=append:/home/ubuntu/ticker-backend.log
StandardError=append:/home/ubuntu/ticker-backend.log

[Install]
WantedBy=multi-user.target
