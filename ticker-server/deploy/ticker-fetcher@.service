[Unit]
Description=Sports Ticker Fetcher %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/backend-components/%i/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TICKER_STOCK_CACHE_PATH=/home/ubuntu/ticker_data/stocks.json
ExecStart=/home/ubuntu/backend-components/%i/current/.venv/bin/python -m backend_ops.worker --component %i --socket /home/ubuntu/ticker_data/backend_sockets/%i.sock --env-file /home/ubuntu/.env
Restart=always
RestartSec=5
TimeoutStopSec=10
MemoryAccounting=true
MemoryMax=768M
TasksMax=96
UMask=0077
StandardOutput=append:/home/ubuntu/ticker-fetcher-%i.log
StandardError=append:/home/ubuntu/ticker-fetcher-%i.log

[Install]
WantedBy=multi-user.target
