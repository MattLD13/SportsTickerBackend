{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,subprocess,sys; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=['repo-agent-start','--hook','claude']; runpy.run_path(str(pathlib.Path(root)/'ai/workspaces/start.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,subprocess,sys; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=['repo-agent-start','--hook','claude']; runpy.run_path(str(pathlib.Path(root)/'ai/workspaces/start.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,subprocess,sys; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=['repo-agent-start','--hook','claude']; runpy.run_path(str(pathlib.Path(root)/'ai/workspaces/start.py'),run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
